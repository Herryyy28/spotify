# ── SECURITY: Firebase credentials (NEVER commit these) ───────────────────────
# firebase_options.dart contains real API keys and project IDs.
# Regenerate using: flutterfire configure
# Keep a private copy outside the repository.
# NOTE: If you intentionally commit this for convenience (not recommended for
# open-source projects), remove the next line. For any public repo, keep it.
# lib/firebase_options.dart

