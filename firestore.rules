rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─── Songs ───────────────────────────────────────────────────────────────
    // Any authenticated user can read (stream). Only admins can write.

    match /songs/{songId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Artists ─────────────────────────────────────────────────────────────

    match /artists/{artistId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Playlists ───────────────────────────────────────────────────────────
    // Public playlists are readable by anyone signed in.
    // Users can create/update/delete their own playlists.

    match /playlists/{playlistId} {
      allow read: if isSignedIn() &&
                     (resource.data.isPublic == true ||
                      isOwner(resource.data.userId) ||
                      isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    // Users read/write their own profile. Admins can read all profiles.

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users can update their own non-admin fields; cannot self-elevate.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['isAdmin', 'createdAt']);

      // Subcollections (likedSongs, history, following)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Analytics events ────────────────────────────────────────────────────

    match /analytics/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
  }
}
